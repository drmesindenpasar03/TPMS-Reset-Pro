                title: "Apa Itu Sensor TPMS?",
                icon: "help-circle",
                content: "TPMS (Tire Pressure Monitoring System) adalah fitur keselamatan canggih berupa sistem elektronik yang dirancang untuk memantau tekanan udara dalam ban pneumatik secara real-time. Sistem ini akan mengirimkan peringatan kepada pengemudi (biasanya berupa lampu kuning berbentuk penampang ban dengan tanda seru) ketika mendeteksi tekanan ban yang kurang secara signifikan (biasanya drop di bawah 25% dari standar)."
            },
            {
                title: "Kapan TPMS Harus Direset?",
                icon: "clock",
                content: "Anda diwajibkan melakukan reset / kalibrasi sistem TPMS pada situasi berikut:<br><br><ul class='list-disc pl-5 space-y-1 mt-2 text-slate-300'><li>Setelah menambah atau mengurangi tekanan angin ban.</li><li>Setelah menambal ban yang bocor.</li><li>Setelah mengganti ban baru atau velg baru.</li><li>Setelah melakukan rotasi ban berkala.</li></ul><br>Tanpa melakukan reset, sistem akan terus menggunakan data lama dan memberikan peringatan yang salah."
            },
            {
                title: "Direct TPMS vs Indirect TPMS",
                icon: "settings",
                content: "<strong class='text-white'>Direct TPMS:</strong> Menggunakan sensor fisik yang menempel pada pentil di dalam ban. Sensor ini mengirimkan data tekanan udara dan suhu spesifik ke komputer mobil secara nirkabel (radio). Keunggulannya sangat akurat.<br><br><strong class='text-white'>Indirect TPMS:</strong> Tidak menggunakan sensor di dalam ban. Sistem ini bergantung pada sensor kecepatan roda (dari sistem ABS). Ban yang kurang angin akan memiliki diameter lebih kecil sehingga berputar lebih cepat dari ban lain. Komputer mendeteksi perbedaan putaran ini sebagai ban kempes."
            },
            {
                title: "Bahaya Mengabaikan Lampu TPMS",
                icon: "alert-triangle",
                content: "Mengabaikan lampu TPMS yang menyala dapat berakibat fatal:<br><br><ol class='list-decimal pl-5 space-y-1 mt-2 text-slate-300'><li><strong>Risiko Kecelakaan:</strong> Ban kurang angin sangat rentan meledak pada kecepatan tinggi karena panas berlebih (overheat).</li><li><strong>Boros BBM:</strong> Ban kempes meningkatkan resistensi gulir, memaksa mesin bekerja lebih keras.</li><li><strong>Keausan Ban Tidak Merata:</strong> Tepi luar ban akan lebih cepat habis, memperpendek usia pakai ban.</li><li><strong>Handling Buruk:</strong> Respons setir menjadi lambat dan jarak pengereman bertambah.</li></ol>"
            }
        ];

        // Initialize Icons
        lucide.createIcons();

        // Render Brands
        const brandsGrid = document.getElementById('brandsGrid');
        const searchInput = document.getElementById('searchInput');
        const noResults = document.getElementById('noResults');

        function renderBrands(filter = "") {
            brandsGrid.innerHTML = '';
            
            const filteredBrands = tpmsDatabase.filter(item => 
                item.brand.toLowerCase().includes(filter.toLowerCase())
            );

            if (filteredBrands.length === 0) {
                brandsGrid.classList.add('hidden');
                noResults.classList.remove('hidden');
                return;
            } else {
                brandsGrid.classList.remove('hidden');
                noResults.classList.add('hidden');
            }

            filteredBrands.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = "futuristic-card rounded-xl p-6 cursor-pointer hover:border-red-600 hover:shadow-[0_0_20px_rgba(220,38,38,0.15)] hover:-translate-y-1 transition-all duration-300 group relative overflow-hidden";
                card.onclick = () => openModal(item);
                
                card.innerHTML = `
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-red-600 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <div class="flex flex-col items-center text-center">
                        <div class="bg-black border border-neutral-800 group-hover:border-red-600/50 p-4 rounded-xl mb-4 transition-colors relative">
                            <i data-lucide="${item.icon}" class="w-10 h-10 text-white group-hover:text-red-500 transition-colors drop-shadow-[0_0_5px_rgba(255,255,255,0.2)] group-hover:drop-shadow-[0_0_15px_rgba(220,38,38,0.8)] relative z-10"></i>
                        </div>
                        <h3 class="text-xl font-black text-white mb-2 uppercase tracking-wider">${item.brand}</h3>
                        <span class="text-xs text-neutral-500 font-mono tracking-widest group-hover:text-red-400 transition-colors flex items-center gap-1 uppercase">
                            Prosedur <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </span>
                    </div>
                `;
                brandsGrid.appendChild(card);
            });
            
            // Re-initialize icons for newly added elements
            lucide.createIcons();
        }

        // Render Tutorials
        function renderTutorials() {
            const tutorialsList = document.getElementById('tutorialsList');
            tutorialsList.innerHTML = '';
            
            tutorialDatabase.forEach(tutorial => {
                const card = document.createElement('div');
                card.className = "futuristic-card rounded-2xl p-8 hover:border-red-600/50 transition-colors group";
                card.innerHTML = `
                    <div class="flex items-center gap-4 mb-6">
                        <div class="bg-black border border-neutral-800 group-hover:border-red-900/50 p-3 rounded-lg text-white group-hover:text-red-500 transition-colors shadow-[0_0_10px_rgba(0,0,0,0.5)]">
                            <i data-lucide="${tutorial.icon}" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-bold text-white uppercase tracking-wide">${tutorial.title}</h3>
                    </div>
                    <p class="text-neutral-400 font-mono text-sm leading-relaxed">${tutorial.content}</p>
                `;
                tutorialsList.appendChild(card);
            });
            lucide.createIcons();
        }

        // Search Event Listener
        searchInput.addEventListener('input', (e) => {
            renderBrands(e.target.value);
        });

        // Tab Switching Logic
        const viewHome = document.getElementById('view-home');
        const viewScanner = document.getElementById('view-scanner');
        const viewTutorial = document.getElementById('view-tutorial');
        
        const tabHome = document.getElementById('tab-home');
        const tabScanner = document.getElementById('tab-scanner');
        const tabTutorial = document.getElementById('tab-tutorial');

        function switchTab(tab) {
            // Hide all views
            viewHome.classList.add('hidden');
            viewHome.classList.remove('block');
            viewScanner.classList.add('hidden');
            viewTutorial.classList.add('hidden');
            
            // Reset all tab styles
            const allTabs = [tabHome, tabScanner, tabTutorial];
            allTabs.forEach(t => {
                t.classList.remove('text-white', 'border-red-600');
                t.classList.add('text-neutral-500', 'border-transparent');
            });

            // Show selected view and activate tab
            if (tab === 'home') {
                viewHome.classList.remove('hidden');
                viewHome.classList.add('block');
                tabHome.classList.add('text-white', 'border-red-600');
                tabHome.classList.remove('text-neutral-500', 'border-transparent');
            } else if (tab === 'scanner') {
                viewScanner.classList.remove('hidden');
                tabScanner.classList.add('text-white', 'border-red-600');
                tabScanner.classList.remove('text-neutral-500', 'border-transparent');
            } else if (tab === 'tutorial') {
                viewTutorial.classList.remove('hidden');
                tabTutorial.classList.add('text-white', 'border-red-600');
                tabTutorial.classList.remove('text-neutral-500', 'border-transparent');
            }
        }

        // Modal Logic
        const modal = document.getElementById('procedureModal');
        const modalCard = document.getElementById('modalCard');
        
        function openModal(data) {
            // Populate Data
            document.getElementById('modalBrandTitle').innerText = data.brand;
            document.getElementById('modalIconContainer').innerHTML = `<i data-lucide="${data.icon}" class="text-white w-8 h-8 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]"></i>`;
            
            const stepsList = document.getElementById('modalStepsList');
            stepsList.innerHTML = '';
            data.steps.forEach((step, index) => {
                stepsList.innerHTML += `
                    <li class="flex gap-4 items-start bg-black/50 p-4 rounded-xl border border-neutral-800 hover:border-red-900/50 transition-colors">
                        <div class="border border-red-600 text-red-500 bg-red-950/20 font-mono font-bold w-8 h-8 rounded-md flex items-center justify-center shrink-0 shadow-[0_0_8px_rgba(220,38,38,0.2)]">
                            0${index + 1}
                        </div>
                        <p class="text-neutral-300 pt-1 leading-relaxed text-sm">${step}</p>
                    </li>
                `;
            });

            const notesSection = document.getElementById('modalNotes');
            if (data.notes) {
                notesSection.classList.remove('hidden');
                document.getElementById('modalNotesText').innerText = data.notes;
            } else {
                notesSection.classList.add('hidden');
            }

            lucide.createIcons();

            // Show Modal with Animation
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            // Small delay to allow display:flex to apply before animating opacity/transform
            setTimeout(() => {
                modalCard.classList.remove('scale-95', 'opacity-0');
                modalCard.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeModal() {
            modalCard.classList.remove('scale-100', 'opacity-100');
            modalCard.classList.add('scale-95', 'opacity-0');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 300); // Wait for transition to finish
        }

        // Initial Renders
        renderBrands();
        renderTutorials();

    </script>
</body>
</html>
